# API base path. Relative by default: the Vite dev server and the nginx image
# both proxy /api to the backend, so the browser never needs the backend origin.
VITE_API_BASE_URL=/api/v1

# Where the proxy forwards /api. Local backend for `npm run dev`; inside the
# container use http://host.docker.internal:8000 (the compose default).
BACKEND_URL=http://localhost:8000

VITE_ADMIN_PAGE_ENABLED=false
VITE_AUTH_ENABLED=true

# Host port for the nginx container (docker compose).
FRONTEND_PORT=8080
