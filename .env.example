# API base path. Relative by default: the Vite dev server and the nginx image
# both proxy /api to the backend, so the browser never needs the backend origin.
VITE_API_BASE_URL=/api/v1

# Where the nginx container forwards /api (container only; compose default is
# the Docker host on :8000). `npm run dev` proxies to http://localhost:8000 and
# takes an override from the shell: BACKEND_URL=http://localhost:9000 npm run dev
#BACKEND_URL=http://host.docker.internal:8000

VITE_ADMIN_PAGE_ENABLED=false
VITE_AUTH_ENABLED=true

# Host port for the nginx container (docker compose).
FRONTEND_PORT=8080
